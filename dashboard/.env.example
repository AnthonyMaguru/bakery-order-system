# Copy to .env.local and adjust.
VITE_API_URL=http://localhost:4000/api

# Local development only: talk to the API as a staff user without Firebase.
# Requires AUTH_DEV_BYPASS=true in backend/.env. Leave empty once Firebase sign-in is wired up.
VITE_DEV_USER=dev-staff

# Firebase web config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
