# Copy to .env.local and adjust.
VITE_API_URL=http://localhost:4000/api

# Test login while there is no Firebase project: talk to the API as a staff user.
# Requires AUTH_DEV_BYPASS=true in backend/.env. Ignored once the Firebase values below are set.
VITE_DEV_USER=dev-staff

# Firebase web config, from Project settings, Your apps, Web app (see docs/firebase.md).
# With these set, the dashboard shows a real sign in page.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
