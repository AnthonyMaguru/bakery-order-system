# Each app has its own .gitignore for build output; this file covers the repo as a whole.

# Dependencies
node_modules/

# Environment and secrets — never commit these
.env
.env.*
!.env.example
secrets/
# Firebase app config files. Not secret, but each copy is tied to one Firebase project.
google-services.json
GoogleService-Info.plist
*service-account*.json
firebase-adminsdk-*.json

# Build output
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
