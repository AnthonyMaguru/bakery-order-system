# Copy to .env and adjust.
NODE_ENV=development
PORT=4000

# Matches docker-compose.yml at the repo root.
DATABASE_URL=postgresql://bakery:bakery@localhost:5432/bakery

# Dashboard origin(s) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Public address of the API, used in photo links. Only needed behind a proxy in production.
# PUBLIC_API_URL=https://api.example.com/api

# Firebase Admin service-account key (Firebase console → Project settings → Service accounts).
# Keep the JSON file outside the repo, or in backend/secrets/ (gitignored).
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# Local development only: accept `x-dev-user` / `x-dev-role` headers instead of Firebase tokens.
AUTH_DEV_BYPASS=true
